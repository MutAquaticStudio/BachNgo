{
  "name": "@bachngo/gsap-kit",
  "version": "0.1.0",
  "description": "GSAP motion kit for the Bách Ngộ storefronts: hero frame, weave transition, shared-element, marquee, parallax, product card, provenance thread, cart drawer.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./react": {
      "types": "./types/react/index.d.ts",
      "import": "./src/react/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "types": "tsc -p tsconfig.json",
    "test": "node build.mjs && node test/smoke.mjs && node storefront/build.mjs && node test/storefront.mjs",
    "build:store": "node storefront/build.mjs",
    "test:store": "node storefront/build.mjs && node test/storefront.mjs"
  },
  "peerDependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "lenis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.128.0",
    "typescript": "^7.0.2"
  }
}